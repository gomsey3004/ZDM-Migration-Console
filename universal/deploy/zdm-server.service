[Unit]
Description=Oracle Zero Downtime Migration server
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/u01/app/zdmhome /u01/app/zdmbase

[Service]
Type=oneshot
RemainAfterExit=yes
User=zdmuser
Group=zdm
Environment=HOME=/home/zdmuser
WorkingDirectory=/home/zdmuser
ExecStart=/usr/local/libexec/zdm-server-boot start
ExecStop=/usr/local/libexec/zdm-server-boot stop
TimeoutStartSec=300
TimeoutStopSec=180
UMask=0077

[Install]
WantedBy=multi-user.target
