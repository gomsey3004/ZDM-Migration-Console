#!/bin/bash
set -euo pipefail
export HOME=/home/zdmuser
export ZDM_HOME=/u01/app/zdmhome
export ZDM_BASE=/u01/app/zdmbase
export PATH="$ZDM_HOME/bin:/usr/local/bin:/usr/bin:/bin"
service="$ZDM_HOME/bin/zdmservice"
case "${1:-}" in
  start)
    if "$service" status 2>&1 | grep -Eq 'Running:[[:space:]]*true'; then
      echo 'ZDM server is already running.'
      exit 0
    fi
    # A shutdown can leave a PID file. Preserve it only when its process is gone.
    pidfile="$ZDM_BASE/crsdata/zdm/rhp/conf/fppserver.pid"
    if [[ -f "$pidfile" ]]; then
      read -r oldpid < "$pidfile" || true
      if [[ "${oldpid:-}" =~ ^[0-9]+$ ]] && [[ ! -d "/proc/$oldpid" ]]; then
        mv -- "$pidfile" "$pidfile.stale-$(date +%Y%m%d%H%M%S)"
      fi
    fi
    "$service" start
    for ((attempt=0; attempt<30; attempt++)); do
      if "$service" status 2>&1 | grep -Eq 'Running:[[:space:]]*true'; then
        echo 'ZDM server is running.'
        exit 0
      fi
      sleep 3
    done
    echo 'ZDM server did not report Running: true.' >&2
    exit 1
    ;;
  stop) exec "$service" stop ;;
  *) echo 'Usage: zdm-server-boot start|stop' >&2; exit 2 ;;
esac
