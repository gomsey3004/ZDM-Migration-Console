[Unit]
Description=ZDM GUI managed hostname entries
After=local-fs.target

[Service]
Type=simple
User=root
Group=zdm
ExecStart=/usr/bin/python3.11 -I /usr/local/libexec/zdm-hosts-manager.py
RuntimeDirectory=zdm-hosts-manager
RuntimeDirectoryMode=0750
StateDirectory=zdm-hosts-manager
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc /var/lib/zdm-hosts-manager /run/zdm-hosts-manager
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
